__pycache__/
*.pyc
*~
.pytest_cache/

# Checkpoints: ignore all .pt except the curated/whitelisted locations.
*.pt
!best_models/**/*.pt

# models/ and working_models/ are local training scratch — never committed.
# Curated checkpoints live in best_models/ (whitelisted above).
models/
working_models/

# build artifacts
c_engine/*.so
c_engine/*.dll
c_engine/.build.lock

# local working data
datasets/
gnubg_games/
gnubg_test/
logs/
**/offline_analysis/*.log

# generated benchmark position pool
**/benchmarks/pool.pkl
**/benchmarks/results.txt
**/benchmarks/bench_*.txt

# Head-to-head raw per-game data (large: each 10M run's .npz is ~72 MB and git
# stores binaries with no delta compression). Keep only the summary CSVs under
# version control; treat raw .npz as out-of-band artifacts. (Already-tracked
# .npz stay tracked; this prevents new ones from being added.)
**/head_to_head/results/**/*.npz

# c-engine build artifact
c_engine/libbg_nply.so

# c_inference build artifacts (build_play.sh)
c_inference/play_models
c_inference/test_nn

# Training run logs — run artifacts, not source.
runlogs/

# Saved-game dirs the README/h2h examples write into.
cubeful_selfplay_games/
cubeful_selfplay_1ply_games/
runaway_games/
