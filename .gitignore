__pycache__/
*.pyc
*~
.pytest_cache/

# Checkpoints: ignore all .pt except the curated/whitelisted locations.
*.pt
!best_models/**/*.pt

# models/ and working_models/ are local training scratch — never committed.
# Curated checkpoints live in best_models/ (whitelisted above).
models/
working_models/

# build artifacts
c_engine/*.so
c_engine/*.dll
c_engine/.build.lock

# local working data
logs/
runs/
gnubg_test/
gnubg_games/
datasets/

# Head-to-head per-game raws (.npz) stay out of git; summaries are committed.
**/head_to_head/results/**/*.npz

# c-engine build artifact
c_engine/libbg_nply.so

# Training run logs — run artifacts, not source.
runlogs/

# Saved-game dirs the README/h2h examples write into.
cubeful_selfplay_games/
cubeful_selfplay_1ply_games/
runaway_games/

# HedgeHog: per-machine shim build + untracked model weights.
third_party_opponents/hedgehog/libhhagent.so
third_party_opponents/hedgehog/shim/build/
*.ogxf

# c_api build artifacts (build.sh)
c_api/*.so
c_api/obj_*/
c_api/puretd_selfplay_*
c_api/*.bin
c_api/.build.lock
third_party_opponents/opensage/opensage_mobile_build/
third_party_opponents/opensage/opensage_bench/build/
